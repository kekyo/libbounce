CC ?= x86_64-w64-mingw32-gcc-win32
CXX = $(subst gcc,g++,$(CC))
WINE ?= wine
WINEBOOT ?= wineboot
PROJECT_ROOT := $(abspath $(dir $(lastword $(MAKEFILE_LIST))))
PREPARE_WINE_RUNTIME ?= $(PROJECT_ROOT)/scripts/prepare_wine_runtime.sh
RUN_WINE_TEST ?= $(PROJECT_ROOT)/scripts/run_wine_test.sh
CC_BASENAME := $(notdir $(CC))
BUILD_DIR ?= build/$(CC_BASENAME)
THREAD_FLAGS :=
SOURCES := \
	src/win32/bounce_tls_win32.c \
	src/win32/bounce_win32.c \
	src/win32/bounce_win32_file.c \
	src/win32/bounce_win32_timer.c
TEST_SOURCES := \
	tests/win32/test_win32.c \
	tests/shared/test_file_header_shared.c \
	tests/shared/test_timer_header_shared.c \
	tests/win32/test_cpp_runtime_win32.cpp \
	tests/win32/test_win32_example.cpp \
	tests/shared/test_cpp_shared.cpp \
	tests/shared/test_file_header_cpp_shared.cpp \
	tests/shared/test_timer_header_cpp_shared.cpp \
	tests/shared/test_cpp_promise_shared.cpp \
	tests/test_harness.c
TEST_HEADERS := tests/test_harness.h tests/shared/test_cpp_runtime.h
EXTRA_COMMON_HEADERS := examples/win32/example_app.h
EXE_EXT := .exe
SHARED_LIB := $(BUILD_DIR)/libbounce.dll
IMPLIB := $(BUILD_DIR)/libbounce.dll.a
SHARED_OBJECTS := $(OBJECTS)
SHARED_LDFLAGS := -Wl,--out-implib,$(IMPLIB)
PLATFORM_LDLIBS := -Wl,-Bstatic -Wl,-Bdynamic -static-libgcc -static-libstdc++ -luser32
SHARED_LDLIBS := -luser32
WIN32_EXAMPLE_EXE := $(BUILD_DIR)/examples/win32/libbounce_win32_example$(EXE_EXT)
WIN32_EXAMPLE_OBJECTS = \
	$(OBJ_DIR)/examples/win32/example_app.example.o \
	$(OBJ_DIR)/examples/win32/main.example.o
WIN32_EXAMPLE_CXXFLAGS := $(CXXFLAGS) -std=c++20 -fcoroutines

ifeq ($(findstring i686,$(CC_BASENAME)),i686)
WINE_ARCH ?= win32
else
WINE_ARCH ?= win64
endif

WINE_PREFIX := $(abspath $(BUILD_DIR)/wineprefix)
WINE_PREFIX_ARCHIVE := $(BUILD_DIR)/wineprefix.tar
WINE_RUNTIME_NAME ?= libbounce-runtime
WINE_TEST_COMMAND = C:/$(WINE_RUNTIME_NAME)/$(notdir $(TESTS))
WINE_ENV := WINEPREFIX=$(WINE_PREFIX) WINEARCH=$(WINE_ARCH) WINEDEBUG=-all

include Makefile.common

.PHONY: test clean example-win32

example-win32: $(STATIC_LIB) $(WIN32_EXAMPLE_EXE)

test: $(STATIC_LIB) $(SHARED_LIB) $(TESTS) $(WIN32_EXAMPLE_EXE) $(PREPARE_WINE_RUNTIME) $(RUN_WINE_TEST)
	WINE="$(WINE)" WINEBOOT="$(WINEBOOT)" $(WINE_ENV) sh "$(RUN_WINE_TEST)" "$(WINE_PREFIX)" "$(WINE_PREFIX_ARCHIVE)" "$(WINE_RUNTIME_NAME)" "$(TESTS)" "$(SHARED_LIB)" "$(WINE_TEST_COMMAND)" "$(WIN32_EXAMPLE_EXE)"

$(WIN32_EXAMPLE_EXE): $(WIN32_EXAMPLE_OBJECTS) $(STATIC_LIB) $(PUBLIC_HEADERS) $(COMMON_HEADERS) | $(BUILD_DIR)
	mkdir -p $(dir $@)
	$(CXX) $(THREAD_FLAGS) $(LDFLAGS) -mwindows -o $@ $(WIN32_EXAMPLE_OBJECTS) $(STATIC_LIB) $(LDLIBS) $(PLATFORM_LDLIBS)

$(OBJ_DIR)/%.example.o: %.cpp $(PUBLIC_HEADERS) $(COMMON_HEADERS) | $(OBJ_DIR)
	mkdir -p $(dir $@)
	$(CXX) $(CPPFLAGS) $(PLATFORM_CPPFLAGS) $(WIN32_EXAMPLE_CXXFLAGS) $(PLATFORM_CXXFLAGS) $(THREAD_FLAGS) -c $< -o $@

clean: clean-common
