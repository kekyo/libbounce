CC ?= cc
BUILD_DIR ?= build/posix
THREAD_FLAGS := -pthread
SOURCES := \
	src/posix/bounce_tls_posix.c \
	src/posix/bounce_posix.c \
	src/posix/bounce_posix_timer.c
TEST_SOURCES := \
	tests/posix/test_posix.c \
	tests/posix/test_posix_runtime.c \
	tests/shared/test_timer_header_shared.c \
	tests/shared/test_cpp_runtime_host.cpp \
	tests/shared/test_posix_freertos_shared.c \
	tests/shared/test_cpp_shared.cpp \
	tests/shared/test_timer_header_cpp_shared.cpp \
	tests/shared/test_cpp_promise_shared.cpp \
	tests/test_harness.c
TEST_HEADERS := tests/test_harness.h tests/shared/test_posix_freertos_shared.h tests/shared/test_posix_freertos_runtime.h tests/shared/test_cpp_runtime.h
TESTS = $(TEST_DIR)/test_posix$(EXE_EXT)
SHARED_LIB = $(BUILD_DIR)/libbounce.so
SHARED_OBJECTS = $(PIC_OBJECTS)
PIC_CFLAGS := -fPIC
PLATFORM_CPPFLAGS := -DBOUNCE_POSIX=1
PLATFORM_LDLIBS :=
SHARED_LDLIBS :=

include Makefile.common

.PHONY: test clean

test: $(STATIC_LIB) $(SHARED_LIB) $(TESTS)
	./$(TESTS)

clean: clean-common
