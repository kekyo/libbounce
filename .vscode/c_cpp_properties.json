{
  "version": 4,
  "configurations": [
    {
      "name": "Linux POSIX",
      "compilerPath": "/usr/bin/cc",
      "intelliSenseMode": "linux-gcc-x64",
      "cStandard": "c99",
      "cppStandard": "c++17",
      "defines": [
        "_XOPEN_SOURCE=700",
        "BOUNCE_POSIX=1"
      ],
      "compilerArgs": [
        "-pthread"
      ],
      "includePath": [
        "${workspaceFolder}/include",
        "${workspaceFolder}",
        "${workspaceFolder}/tests"
      ],
      "browse": {
        "path": [
          "${workspaceFolder}/include",
          "${workspaceFolder}/src",
          "${workspaceFolder}/tests"
        ],
        "limitSymbolsToIncludedHeaders": true
      }
    },
    {
      "name": "Linux POSIX-GLib",
      "compilerPath": "/usr/bin/cc",
      "intelliSenseMode": "linux-gcc-x64",
      "cStandard": "c99",
      "cppStandard": "c++17",
      "defines": [
        "BOUNCE_POSIX_GLIB=1"
      ],
      "compilerArgs": [
        "-pthread"
      ],
      "includePath": [
        "${workspaceFolder}/include",
        "${workspaceFolder}",
        "${workspaceFolder}/tests",
        "/usr/include/glib-2.0",
        "/usr/lib/x86_64-linux-gnu/glib-2.0/include",
        "/usr/include/gio-unix-2.0",
        "/usr/include/libmount",
        "/usr/include/blkid"
      ],
      "browse": {
        "path": [
          "${workspaceFolder}/include",
          "${workspaceFolder}/src",
          "${workspaceFolder}/tests",
          "${workspaceFolder}/samples",
          "/usr/include/glib-2.0",
          "/usr/lib/x86_64-linux-gnu/glib-2.0/include",
          "/usr/include/gio-unix-2.0",
          "/usr/include/libmount",
          "/usr/include/blkid"
        ],
        "limitSymbolsToIncludedHeaders": true
      }
    },
    {
      "name": "Linux FreeRTOS (POSIX port)",
      "compilerPath": "/usr/bin/cc",
      "intelliSenseMode": "linux-gcc-x64",
      "cStandard": "c99",
      "cppStandard": "c++17",
      "defines": [
        "_XOPEN_SOURCE=700",
        "BOUNCE_FREERTOS=1"
      ],
      "compilerArgs": [
        "-pthread"
      ],
      "includePath": [
        "${workspaceFolder}/include",
        "${workspaceFolder}",
        "${workspaceFolder}/tests",
        "${workspaceFolder}/tests/freertos",
        "${workspaceFolder}/build/freertos/FreeRTOS-Kernel-V11.2.0/include",
        "${workspaceFolder}/build/freertos/FreeRTOS-Kernel-V11.2.0/portable/ThirdParty/GCC/Posix"
      ],
      "browse": {
        "path": [
          "${workspaceFolder}/include",
          "${workspaceFolder}/src",
          "${workspaceFolder}/tests",
          "${workspaceFolder}/samples",
          "${workspaceFolder}/build/freertos/FreeRTOS-Kernel-V11.2.0/include",
          "${workspaceFolder}/build/freertos/FreeRTOS-Kernel-V11.2.0/portable/ThirdParty/GCC/Posix"
        ],
        "limitSymbolsToIncludedHeaders": true
      }
    },
    {
      "name": "ESP-IDF FreeRTOS fd await",
      "compilerPath": "/usr/bin/cc",
      "intelliSenseMode": "linux-gcc-x64",
      "cStandard": "c99",
      "cppStandard": "c++17",
      "defines": [
        "_XOPEN_SOURCE=700",
        "BOUNCE_FREERTOS=1",
        "ESP_PLATFORM=1",
        "BOUNCE_FREERTOS_ENABLE_FD_AWAIT=1"
      ],
      "compilerArgs": [
        "-pthread"
      ],
      "includePath": [
        "${workspaceFolder}/include",
        "${workspaceFolder}",
        "${workspaceFolder}/tests",
        "${workspaceFolder}/tests/freertos",
        "${workspaceFolder}/build/freertos/FreeRTOS-Kernel-V11.2.0/include",
        "${workspaceFolder}/build/freertos/FreeRTOS-Kernel-V11.2.0/portable/ThirdParty/GCC/Posix"
      ],
      "browse": {
        "path": [
          "${workspaceFolder}/include",
          "${workspaceFolder}/src",
          "${workspaceFolder}/tests",
          "${workspaceFolder}/samples",
          "${workspaceFolder}/build/freertos/FreeRTOS-Kernel-V11.2.0/include",
          "${workspaceFolder}/build/freertos/FreeRTOS-Kernel-V11.2.0/portable/ThirdParty/GCC/Posix"
        ],
        "limitSymbolsToIncludedHeaders": true
      }
    },
    {
      "name": "Win32 x64 (MinGW)",
      "compilerPath": "/usr/bin/x86_64-w64-mingw32-gcc",
      "intelliSenseMode": "windows-gcc-x64",
      "cStandard": "c99",
      "cppStandard": "c++17",
      "defines": [
        "_WIN32",
        "_WIN64"
      ],
      "includePath": [
        "${workspaceFolder}/include",
        "${workspaceFolder}",
        "${workspaceFolder}/tests"
      ],
      "browse": {
        "path": [
          "${workspaceFolder}/include",
          "${workspaceFolder}/src",
          "${workspaceFolder}/tests",
          "${workspaceFolder}/samples"
        ],
        "limitSymbolsToIncludedHeaders": true
      }
    },
    {
      "name": "Win32 x86 (MinGW)",
      "compilerPath": "/usr/bin/i686-w64-mingw32-gcc",
      "intelliSenseMode": "windows-gcc-x86",
      "cStandard": "c99",
      "cppStandard": "c++17",
      "defines": [
        "_WIN32"
      ],
      "includePath": [
        "${workspaceFolder}/include",
        "${workspaceFolder}",
        "${workspaceFolder}/tests"
      ],
      "browse": {
        "path": [
          "${workspaceFolder}/include",
          "${workspaceFolder}/src",
          "${workspaceFolder}/tests"
        ],
        "limitSymbolsToIncludedHeaders": true
      }
    }
  ]
}
